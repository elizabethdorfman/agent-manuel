{
  "check": "contrast",
  "fixture": "examples/checks/contrast.html",
  "viewports": [{ "width": 390, "height": 844 }, { "width": 1280, "height": 800 }],
  "note": "ratio is the WCAG ratio against the sampled background (checked to ±0.05). min/max bound a non-uniform background.",
  "elements": {
    "#heading":                  { "expected": "none",   "ratio": 17.4 },
    "#light-grey":               { "expected": "fail",   "ratio": 1.92, "note": "#bbbbbb on white." },
    "#grey-46":                  { "expected": "none",   "ratio": 4.61, "note": "#757575 on white: just passes 4.5." },
    "#grey-35-normal":           { "expected": "fail",   "ratio": 3.5,  "note": "#898989 at 16px needs 4.5." },
    "#grey-35-large":            { "expected": "none",   "ratio": 3.5,  "note": "Same grey at 24px: large text needs 3." },
    "#grey-35-bold":             { "expected": "none",   "ratio": 3.5,  "note": "19px bold is large (≥18.66px and ≥700)." },
    "#grey-35-regular-19":       { "expected": "fail",   "ratio": 3.5,  "note": "19px regular is normal text." },
    "#alpha-text":               { "expected": "fail",   "ratio": 2.68, "note": "rgba(0,0,0,.38) composites to #9e9e9e." },
    "#faded-by-parent":          { "expected": "fail",   "ratio": 1.93, "note": "Dark text under a 30% opacity ancestor." },
    "#white-on-gradient":        { "expected": "review", "minBelow": 4.5, "maxAbove": 4.5, "note": "White over #1a1a1a→#e6e6e6: passes on the left, fails on the right." },
    "#white-on-dark-gradient":   { "expected": "none",   "note": "Gradient, but every sample passes." },
    "#photo-caption":            { "expected": "review", "minBelow": 4.5, "maxAbove": 4.5, "note": "White over a pale sky and dark hills (SVG stand-in photo)." },
    "#dark-panel":               { "expected": "none",   "ratio": 14.68 },
    "#link-para":                { "expected": "none",   "ratio": 17.4, "note": "The link's glyphs are excluded from the paragraph's background." },
    "#inline-link":              { "expected": "none",   "ratio": 8.53 },
    "#input-value":              { "expected": "none",   "ratio": 17.4 },
    "#input-placeholder-light":  { "expected": "fail",   "ratio": 1.67, "note": "Placeholder #c8c8c8." },
    "#input-placeholder-ok":     { "expected": "none",   "ratio": 5.33 },
    "#disabled-button":          { "expected": "none",   "skipped": "disabled", "note": "Low contrast, but disabled controls are exempt." },
    "#enabled-button":           { "expected": "none",   "ratio": 15.82 },
    "#hidden-low":               { "expected": "none",   "skipped": "hidden" }
